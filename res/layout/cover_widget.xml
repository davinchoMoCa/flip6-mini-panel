<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UseAppTint" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_bg">
  <TextClock android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="36sp" android:textColor="#E1E4DC" />
  <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Música y aplicaciones" android:textSize="14sp" android:textColor="#C2C9BE" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <ImageView android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_tonal" android:padding="12dp" android:src="@drawable/ic_previous" android:tint="#DCE8DC" android:contentDescription="Canción anterior" />
    <ImageView android:id="@+id/widget_play" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_primary" android:padding="12dp" android:src="@drawable/ic_play_pause" android:tint="#233629" android:contentDescription="Reproducir o pausar" />
    <ImageView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_tonal" android:padding="12dp" android:src="@drawable/ic_next" android:tint="#DCE8DC" android:contentDescription="Canción siguiente" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/widget_lower" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_tonal" android:gravity="center" android:text="Vol −" android:textSize="14sp" android:textColor="#DCE8DC" android:contentDescription="Vol −" />
    <TextView android:id="@+id/widget_raise" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_tonal" android:gravity="center" android:text="Vol +" android:textSize="14sp" android:textColor="#DCE8DC" android:contentDescription="Vol +" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/widget_spotify" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_tonal" android:gravity="center" android:text="Spotify" android:textSize="14sp" android:textColor="#DCE8DC" android:contentDescription="Spotify" />
    <TextView android:id="@+id/widget_apps" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/widget_tonal" android:gravity="center" android:text="Aplicaciones" android:textSize="14sp" android:textColor="#DCE8DC" android:contentDescription="Aplicaciones" />
  </LinearLayout>
  <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="Abrir escritorio" android:textColor="#B7D5BC" android:textSize="14sp" />
</LinearLayout>
